{
  "schemaVersion": 1,
  "id": "ai-usage",
  "name": "AI Usage",
  "version": "1.1.0",
  "author": "Cees Kettenis",
  "license": "MIT",
  "description": "Cached OpenAI and Claude usage across multiple local profiles.",
  "kinds": [
    "bar-widget"
  ],
  "activation": "on-demand",
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "AI Usage",
    "description": "Show cached OpenAI and Claude limits for every configured profile.",
    "category": "AI",
    "aliases": [
      "ai-usage",
      "usage-status",
      "codex-usage"
    ],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 900,
      "codexProfilesRoot": "~/.codex-profiles",
      "claudeProfilesRoot": "~/.claude",
      "refreshMode": "Scheduled",
      "hoverCooldownSec": 60,
      "privacyMode": "On",
      "sleepMode": "Off",
      "sleepStart": "17:00",
      "sleepEnd": "07:30"
    },
    "schema": [
      {
        "key": "codexProfilesRoot",
        "type": "string",
        "label": "OpenAI / Codex profiles folder",
        "defaultValue": "~/.codex-profiles",
        "description": "A Codex home or a folder whose immediate subfolders contain Codex auth.json files."
      },
      {
        "key": "claudeProfilesRoot",
        "type": "string",
        "label": "Claude profiles folder",
        "defaultValue": "~/.claude",
        "description": "A Claude config home or a folder whose immediate subfolders are separate CLAUDE_CONFIG_DIR homes."
      },
      {
        "key": "refreshMode",
        "type": "enum",
        "label": "Refresh mode",
        "options": [
          "On hover/open",
          "Scheduled",
          "Both"
        ],
        "defaultValue": "Scheduled",
        "description": "Fetch on interaction, on the configured schedule, or both."
      },
      {
        "key": "hoverCooldownSec",
        "type": "integer",
        "label": "Hover cooldown (seconds)",
        "min": 30,
        "max": 3600,
        "step": 30,
        "defaultValue": 60,
        "description": "Minimum time between hover-triggered refreshes."
      },
      {
        "key": "privacyMode",
        "type": "enum",
        "label": "Privacy mode",
        "options": [
          "Off",
          "On"
        ],
        "defaultValue": "On",
        "description": "Hide account email and subscription details in the popup."
      },
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 30,
        "max": 3600,
        "step": 30,
        "defaultValue": 900
      },
      {
        "key": "sleepMode",
        "type": "enum",
        "label": "Sleep mode",
        "options": [
          "Off",
          "On"
        ],
        "defaultValue": "Off",
        "description": "Pause automatic usage checks during the configured sleep window."
      },
      {
        "key": "sleepStart",
        "type": "string",
        "label": "Sleep starts",
        "defaultValue": "17:00",
        "description": "Local time in 24-hour HH:MM format."
      },
      {
        "key": "sleepEnd",
        "type": "string",
        "label": "Sleep ends",
        "defaultValue": "07:30",
        "description": "Local time in 24-hour HH:MM format."
      }
    ]
  }
}
